{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ww-ocr",
  "version": "0.1.0",
  "identifier": "com.huangw.ww-ocr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ww-ocr",
        "width": 800,
        "height": 600,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["models/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
